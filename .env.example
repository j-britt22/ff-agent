# ══════════════════════════════════════════════════════════════════════════════
#  ESPN CREDENTIALS — TEMPLATE (copy to .env and fill in)
#
#  Paste your real values after the "=" on each line. No quotes. No spaces
#  around the "=". Then save. Nothing else in this file needs to change.
#
#  ⚠  These cookies ARE login credentials. Treat them like a password.
#     This file is gitignored (verified) and chmod 600. Never commit it,
#     never paste these values into a chat, never screenshot them.
#
#  ⚠  They EXPIRE. Re-grab them the morning of the draft and verify the
#     connection BEFORE you are on the clock. See SETUP.md §3.
# ══════════════════════════════════════════════════════════════════════════════


# ─── 1. League ID ─────────────────────────────────────────────────────────────
# From your league URL:
#     https://fantasy.espn.com/football/league?leagueId=123456
#                                                       ^^^^^^
# Digits only.
#   example →  ESPN_LEAGUE_ID=123456

ESPN_LEAGUE_ID=


# ─── 2. espn_s2 ───────────────────────────────────────────────────────────────
# Dev tools → Application (Chrome/Edge) or Storage (Firefox) → Cookies →
# https://fantasy.espn.com → row named "espn_s2".
# Long string. Contains % characters — KEEP them, do not decode or unescape.
#   example →  ESPN_S2=AEBb7RiVpX%2FQm3kZ9nT4uLc%2BdW1yH0jGf8sOaPzE%3D

ESPN_S2=


# ─── 3. SWID ──────────────────────────────────────────────────────────────────
# Same cookie list, row named "SWID".
# KEEP the curly braces — they are part of the value.
#   example →  ESPN_SWID={1A2B3C4D-5E6F-7A8B-9C0D-1E2F3A4B5C6D}

ESPN_SWID=
