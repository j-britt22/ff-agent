# ══════════════════════════════════════════════════════════════════════════════
#  SMTP — how the monitor reaches me (copy to .env.notify and fill in)
#
#  DELIBERATELY SEPARATE from .env. The ESPN cookies are a league login; these
#  are a mail login. Keeping them apart means one leak is not two.
#
#  With Gmail this must be an APP PASSWORD, not the account password:
#  Google Account -> Security -> 2-Step Verification -> App passwords.
# ══════════════════════════════════════════════════════════════════════════════

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=

# Where the digest lands. Can be the same address.
DIGEST_TO=you@gmail.com

# Optional. Blank falls back to SMTP_USER above — leaving this empty is safe.
DIGEST_FROM=

# Optional — the news layer (ff_agent/inseason/news.py). Without it the digest
# ships the numbers and says the news layer was skipped.
ANTHROPIC_API_KEY=
