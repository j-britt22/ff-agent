# ─── SECRETS ─────────────────────────────────────────────────────────────────
# ESPN_S2 and SWID are login credentials. Never commit, never paste in chat.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
cookies.json

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# .python-version is deliberately TRACKED — draft day must reproduce the exact
# interpreter this was rehearsed on. Do not add it here.
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# ─── Data cache (re-fetchable; large; not source) ────────────────────────────
data/cache/
data/raw/
*.parquet
*.duckdb
*.duckdb.wal
*.sqlite

# ─── Generated artifacts (§4) ────────────────────────────────────────────────
# Regenerated by the pipeline. Tracked snapshots, if wanted, go in artifacts/pinned/.
artifacts/board.json
artifacts/plan_*.json
artifacts/plans_index.json
artifacts/draft_pool.parquet
artifacts/scenario_offsets.npz
artifacts/opponents.json
artifacts/season_sim.json
artifacts/draft_sim.json
artifacts/*.pdf

# ─── Logs (§10 requires recommendation logs; keep them local) ────────────────
logs/
# M10b dedupe + last-success state. Per-machine, like the cache.
state/
*.log

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ─── Working reports (regenerated; not source) ───────────────────────────────
reports/

# M5 artifact
artifacts/opponents.json
artifacts/season_sim.json
