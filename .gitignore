# ─── SECRETS ─────────────────────────────────────────────────────────────────
# ESPN_S2 and SWID are login credentials. Never commit, never paste in chat.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
cookies.json

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# ─── Data cache (re-fetchable; large; not source) ────────────────────────────
data/cache/
data/raw/
*.parquet
*.duckdb
*.duckdb.wal
*.sqlite

# ─── Generated artifacts (§4) ────────────────────────────────────────────────
